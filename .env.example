HOST=127.0.0.1
PORT=8000
# Generate at runtime, for example:
# export MANAGEMENT_API_KEY="$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')"
MANAGEMENT_API_KEY=

# DeepSeek Responses API example. Inject the real key securely; keep it empty here.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30

# Handler generation backend: direct (Responses API) or pi (Pi RPC coding agent).
GENERATION_BACKEND=direct

# Pi 0.84.4+ example. Pi runs without tools and receives LLM_API_KEY in this env name.
# Install separately; it is intentionally not a Python dependency.
PI_EXECUTABLE=pi
PI_PROVIDER=deepseek
PI_MODEL=deepseek-v4-pro
PI_TIMEOUT_SECONDS=600
PI_MAX_EVENT_STREAM_BYTES=67108864
PI_MAX_CONCURRENT_RUNS=1
PI_ADMISSION_TIMEOUT_SECONDS=1
PI_WORKSPACE_ROOT=generated/pi-workspaces
PI_PROVIDER_ENV_NAME=DEEPSEEK_API_KEY

GENERATED_DIR=generated
METADATA_DB_PATH=generated/runtime-metadata.sqlite3
MAX_REQUEST_BODY_BYTES=1048576
MAX_HANDLER_RESULT_BYTES=1048576
HANDLER_TIMEOUT_SECONDS=2
HANDLER_MEMORY_LIMIT_MB=256
HANDLER_CPU_LIMIT_SECONDS=1
MAX_CONCURRENT_HANDLERS=4
HANDLER_ADMISSION_TIMEOUT_SECONDS=0.1
