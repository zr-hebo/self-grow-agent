HOST=127.0.0.1
PORT=8000
# Generate at runtime, for example:
# export MANAGEMENT_API_KEY="$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')"
MANAGEMENT_API_KEY=

# DeepSeek Responses API example. Inject the real key securely; keep it empty here.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30

# Handler generation backend: direct (Responses API) or pi (Pi RPC coding agent).
GENERATION_BACKEND=direct

# Pi 0.84.4+ example. Pi runs without tools and receives LLM_API_KEY in this env name.
# Install separately; it is intentionally not a Python dependency.
PI_EXECUTABLE=pi
PI_PROVIDER=deepseek
PI_MODEL=deepseek-v4-pro
# Structured code generation should not inherit Pi's medium default. For this
# model medium/low are unsupported and Pi clamps them upward to high.
PI_THINKING_LEVEL=off
PI_TIMEOUT_SECONDS=600
PI_MAX_EVENT_STREAM_BYTES=67108864
PI_MAX_CONCURRENT_RUNS=1
PI_ADMISSION_TIMEOUT_SECONDS=1
PI_WORKSPACE_ROOT=generated/pi-workspaces
PI_PROVIDER_ENV_NAME=DEEPSEEK_API_KEY

# Full API plugin generation uses an external operation workspace. Dependencies
# are denied unless exact pins are listed here, separated by commas.
PLUGIN_WORKSPACE_ROOT=/tmp/self-grow-agent-workspaces
PLUGIN_ARTIFACT_ROOT=generated/plugins
PLUGIN_ALLOWED_DEPENDENCIES=
# Format: project:ENV_NAME,project:OTHER_ENV_NAME. Agent/LLM credentials are forbidden.
PLUGIN_PROJECT_ENV_ALLOWLIST=
PLUGIN_MAX_FILES=32
PLUGIN_MAX_FILE_BYTES=262144
PLUGIN_MAX_TOTAL_BYTES=1048576
PLUGIN_KEEP_FAILED_WORKSPACES=true
# process for local development; container for hardened production execution.
PLUGIN_EXECUTION_BACKEND=process
PLUGIN_CONTAINER_RUNTIME=docker
PLUGIN_CONTAINER_IMAGE=self-grow-agent-plugin-runtime:latest
# Optional format: project:docker-network,other-project:other-network.
# Container plugins otherwise run with --network none.
PLUGIN_PROJECT_CONTAINER_NETWORKS=

GENERATED_DIR=generated
METADATA_DB_PATH=generated/runtime-metadata.sqlite3
MAX_REQUEST_BODY_BYTES=1048576
MAX_HANDLER_RESULT_BYTES=1048576
HANDLER_TIMEOUT_SECONDS=2
HANDLER_MEMORY_LIMIT_MB=256
HANDLER_CPU_LIMIT_SECONDS=1
MAX_CONCURRENT_HANDLERS=4
HANDLER_ADMISSION_TIMEOUT_SECONDS=0.1
